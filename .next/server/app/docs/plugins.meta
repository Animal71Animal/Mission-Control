{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/docs/layout,_N_T_/docs/plugins/layout,_N_T_/docs/plugins/page,_N_T_/docs/plugins"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/docs/plugins/__PAGE__",
    "/docs/plugins",
    "/docs",
    "/_index",
    "/_head"
  ]
}