{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/docs/layout,_N_T_/docs/video-prompts/layout,_N_T_/docs/video-prompts/page,_N_T_/docs/video-prompts"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/docs/video-prompts/__PAGE__",
    "/docs/video-prompts",
    "/docs",
    "/_index",
    "/_head"
  ]
}